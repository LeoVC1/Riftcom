@*
    Riftcom logo mark. Two overlapping card silhouettes suggesting the "rift" between them,
    on a violet gradient badge. Purely inline SVG — no external assets.
*@
<svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg" aria-label="Riftcom">
    <defs>
        <linearGradient id="rc-grad" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#8b5cf6"/>
            <stop offset="0.55" stop-color="#6d28d9"/>
            <stop offset="1" stop-color="#3b0764"/>
        </linearGradient>
    </defs>
    <rect x="0" y="0" width="40" height="40" rx="9" fill="url(#rc-grad)"/>
    <g transform="translate(20 20)">
        <rect x="-9" y="-11" width="10" height="16" rx="1.5" fill="none" stroke="#fff" stroke-width="1.8"
              opacity="0.85" transform="rotate(-10) translate(-1 -0.5)"/>
        <rect x="-1" y="-9" width="10" height="16" rx="1.5" fill="#fbbf24"
              transform="rotate(10) translate(0 0.5)"/>
        <line x1="1" y1="-7" x2="7" y2="-7" stroke="#78350f" stroke-width="0.7" opacity="0.65"/>
        <line x1="1" y1="-5" x2="7" y2="-5" stroke="#78350f" stroke-width="0.7" opacity="0.65"/>
        <line x1="1" y1="-3" x2="5" y2="-3" stroke="#78350f" stroke-width="0.7" opacity="0.5"/>
    </g>
</svg>

@model RiftboundStore.Models.Card
@{
    ViewData["Title"] = Model.Name;
}

<div class="row g-4">
    <div class="col-md-5">
        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded shadow-sm" />
        }
        else
        {
            <div class="bg-light d-flex align-items-center justify-content-center rounded" style="height:400px">
                <span class="text-muted">Sem imagem</span>
            </div>
        }
    </div>
    <div class="col-md-7">
        <h1 class="h3">@Model.Name</h1>
        <p class="text-muted mb-3">Nº @Model.Number · Edição @Model.Edition</p>

        <ul class="list-unstyled">
            <li><strong>Idioma:</strong> @(Model.Language == RiftboundStore.Models.CardLanguage.Chinese ? "Chinês" : "Inglês")</li>
            <li><strong>Foil:</strong> @(Model.IsFoil ? "Sim" : "Não")</li>
            <li><strong>Estoque:</strong> @Model.Stock</li>
        </ul>

        @if (Model.Stock > 0)
        {
            <form asp-controller="Cart" asp-action="Add" method="post" class="d-flex gap-2 align-items-center">
                <input type="hidden" name="cardId" value="@Model.Id" />
                <input type="number" name="quantity" value="1" min="1" max="@Model.Stock" class="form-control" style="width:100px" />
                <button type="submit" class="btn btn-primary">Adicionar ao carrinho</button>
            </form>
        }
        else
        {
            <div class="alert alert-warning">Carta esgotada no momento.</div>
        }

        <a asp-action="Index" class="btn btn-link ps-0 mt-3">← Voltar</a>
    </div>
</div>

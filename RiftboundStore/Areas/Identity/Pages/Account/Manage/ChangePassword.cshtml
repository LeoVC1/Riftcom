@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Alterar senha";
}

<h2 class="h5 mb-3">Alterar senha</h2>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-info">@Model.StatusMessage</div>
}

<form method="post" class="col-md-8">
    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

    <div class="mb-3">
        <label asp-for="Input.OldPassword" class="form-label">Senha atual</label>
        <input asp-for="Input.OldPassword" class="form-control" type="password" autocomplete="current-password" />
        <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.NewPassword" class="form-label">Nova senha</label>
        <input asp-for="Input.NewPassword" class="form-control" type="password" autocomplete="new-password" />
        <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.ConfirmPassword" class="form-label">Confirmar nova senha</label>
        <input asp-for="Input.ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary">Alterar senha</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

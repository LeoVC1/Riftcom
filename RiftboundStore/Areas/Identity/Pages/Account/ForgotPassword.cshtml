@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Esqueci a senha";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <h1 class="h4 mb-3 text-center">Esqueci a senha</h1>
                <p class="text-muted small">Envio de e-mail não está configurado ainda. Entre em contato com o administrador para redefinir a senha.</p>
                <form method="post">
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">E-mail</label>
                        <input asp-for="Input.Email" class="form-control" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Enviar</button>
                    <a asp-page="./Login" class="btn btn-link w-100 mt-2">Voltar ao login</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

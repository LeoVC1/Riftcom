@model RiftboundStore.Models.Card
@{
    ViewData["Title"] = "Nova carta";
}

<h1 class="h4 mb-3">Nova carta</h1>

<form asp-action="Create" method="post" enctype="multipart/form-data" class="row g-3">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="@(ViewData.ModelState.ErrorCount > 0 ? "" : "display:none")"></div>

    <div class="col-md-8">
        <label asp-for="Name" class="form-label">Nome</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Number" class="form-label">Número</label>
        <input asp-for="Number" class="form-control" />
        <span asp-validation-for="Number" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Edition" class="form-label">Edição</label>
        <input asp-for="Edition" class="form-control" list="editions-list" />
        <span asp-validation-for="Edition" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Language" class="form-label">Idioma</label>
        <select asp-for="Language" class="form-select">
            <option value="English">Inglês</option>
            <option value="Chinese">Chinês</option>
        </select>
    </div>
    <div class="col-md-3">
        <label asp-for="Stock" class="form-label">Estoque</label>
        <input asp-for="Stock" type="number" min="0" class="form-control" />
        <span asp-validation-for="Stock" class="text-danger small"></span>
    </div>

    <div class="col-md-3 d-flex align-items-end">
        <div class="form-check">
            <input asp-for="IsFoil" class="form-check-input" />
            <label asp-for="IsFoil" class="form-check-label">Foil</label>
        </div>
    </div>

    <div class="col-md-6">
        <label class="form-label">Imagem (upload)</label>
        <input type="file" name="image" class="form-control" accept="image/*" />
        <small class="text-muted">JPG/PNG/WEBP até 4MB.</small>
    </div>
    <div class="col-md-6">
        <label asp-for="ImageUrl" class="form-label">... ou URL da imagem</label>
        <input asp-for="ImageUrl" class="form-control" />
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a asp-action="Index" class="btn btn-link">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model RiftboundStore.Models.ViewModels.AdminCardsIndexViewModel
@using RiftboundStore.Models
@{
    ViewData["Title"] = "Cartas";
    var q = Model.Query;
    var page = Model.Page;
    var totalPages = Model.TotalPages;

    Dictionary<string, string?> RouteFor(int p) => new()
    {
        ["q"] = Model.Query,
        ["edition"] = Model.Edition,
        ["language"] = Model.Language?.ToString(),
        ["rarity"] = Model.Rarity,
        ["foil"] = Model.Foil?.ToString().ToLower(),
        ["inStockOnly"] = Model.InStockOnly.ToString().ToLower(),
        ["sort"] = Model.Sort,
        ["page"] = p.ToString()
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Cartas</h1>
    <a asp-action="Create" class="btn btn-primary">+ Nova carta</a>
</div>

<form method="get" class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">Buscar</label>
                <input type="text" name="q" value="@q" class="form-control form-control-sm" placeholder="Nome, número ou edição" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Edição</label>
                <select name="edition" class="form-select form-select-sm">
                    <option value="">Todas</option>
                    @foreach (var ed in Model.Editions)
                    {
                        var selected = ed == Model.Edition ? "selected" : null;
                        <option value="@ed" selected="@selected">@ed</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Raridade</label>
                <select name="rarity" class="form-select form-select-sm">
                    <option value="">Todas</option>
                    <option value="common"   selected="@(Model.Rarity == "common")">Comum</option>
                    <option value="uncommon" selected="@(Model.Rarity == "uncommon")">Incomum</option>
                    <option value="rare"     selected="@(Model.Rarity == "rare")">Raro</option>
                    <option value="epic"     selected="@(Model.Rarity == "epic")">Épico</option>
                    <option value="other"    selected="@(Model.Rarity == "other")">Outros</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Idioma</label>
                <select name="language" class="form-select form-select-sm">
                    <option value="">Todos</option>
                    <option value="English" selected="@(Model.Language == CardLanguage.English)">Inglês</option>
                    <option value="Chinese" selected="@(Model.Language == CardLanguage.Chinese)">Chinês</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Foil</label>
                <select name="foil" class="form-select form-select-sm">
                    <option value="">Todos</option>
                    <option value="true" selected="@(Model.Foil == true)">Sim</option>
                    <option value="false" selected="@(Model.Foil == false)">Não</option>
                </select>
            </div>
        </div>
        <div class="row g-2 align-items-end mt-1">
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Ordenar por</label>
                <select name="sort" class="form-select form-select-sm">
                    <option value="edition"      selected="@(Model.Sort == "edition")">Edição</option>
                    <option value="name"         selected="@(Model.Sort == "name")">Nome</option>
                    <option value="number_asc"   selected="@(Model.Sort == "number_asc")">Número (0 → 100)</option>
                    <option value="number_desc"  selected="@(Model.Sort == "number_desc")">Número (100 → 0)</option>
                    <option value="stock_desc"   selected="@(Model.Sort == "stock_desc")">Estoque (maior)</option>
                    <option value="stock_asc"    selected="@(Model.Sort == "stock_asc")">Estoque (menor)</option>
                    <option value="recent"       selected="@(Model.Sort == "recent")">Alterada recentemente</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-center pt-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="inStockOnly" value="true"
                           id="inStockOnly" @(Model.InStockOnly ? "checked" : "") />
                    <label class="form-check-label" for="inStockOnly">Somente com estoque</label>
                </div>
            </div>
            <div class="col-md-6 d-flex justify-content-end gap-2 pt-4">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Limpar</a>
                <button type="submit" class="btn btn-primary btn-sm">Aplicar filtros</button>
            </div>
        </div>
    </div>
</form>

<div class="d-flex justify-content-between align-items-center mb-2">
    <span class="text-muted small">@Model.TotalCount resultado(s)</span>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th></th>
                <th>Nome</th>
                <th>Nº</th>
                <th>Edição</th>
                <th>Idioma</th>
                <th>Foil</th>
                <th style="min-width:180px">Estoque</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var c in Model.Cards)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrWhiteSpace(c.ImageUrl))
                    {
                        <img src="@c.ImageUrl" style="width:40px;height:40px;object-fit:contain;background:#f8f9fa" alt="" />
                    }
                </td>
                <td>@c.Name</td>
                <td>@c.Number</td>
                <td>@c.Edition</td>
                <td>@(c.Language == CardLanguage.Chinese ? "Chinês" : "Inglês")</td>
                <td>
                    <form asp-action="UpdateFoil" method="post" class="foil-editor d-inline-block">
                        <input type="hidden" name="id" value="@c.Id" />
                        <input type="hidden" name="q" value="@q" />
                        <input type="hidden" name="page" value="@(page)" />
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input foil-toggle" type="checkbox"
                                   role="switch" name="isFoil" value="true"
                                   id="foil-@c.Id"
                                   @(c.IsFoil ? "checked" : "")
                                   aria-label="Foil de @c.Name" />
                            <label class="form-check-label small" for="foil-@c.Id">
                                @(c.IsFoil ? "Sim" : "Não")
                            </label>
                        </div>
                    </form>
                </td>
                <td>
                    <form asp-action="UpdateStock" method="post" class="stock-editor d-inline-flex align-items-center">
                        <input type="hidden" name="id" value="@c.Id" />
                        <input type="hidden" name="q" value="@q" />
                        <input type="hidden" name="page" value="@(page)" />
                        <button type="submit" name="delta" value="-1"
                                class="btn btn-sm btn-outline-secondary stock-btn"
                                title="Diminuir 1"
                                @(c.Stock <= 0 ? "disabled" : null)>−</button>
                        <input type="number" name="newStock" value="@c.Stock" min="0" max="10000"
                               class="form-control form-control-sm stock-input text-center"
                               aria-label="Estoque de @c.Name" />
                        <button type="submit" name="delta" value="1"
                                class="btn btn-sm btn-outline-secondary stock-btn"
                                title="Aumentar 1">+</button>
                    </form>
                </td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                    <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Remover essa carta?')">Remover</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if (totalPages > 1)
{
    var current = page;
    var total = totalPages;
    var window = 1;
    var pages = new List<int?>();
    pages.Add(1);
    if (current - window > 2) pages.Add(null);
    for (int p = Math.Max(2, current - window); p <= Math.Min(total - 1, current + window); p++)
        pages.Add(p);
    if (current + window < total - 1) pages.Add(null);
    if (total > 1) pages.Add(total);

    <nav class="mt-3" aria-label="Paginação">
        <ul class="pagination pagination-compact justify-content-center">
            <li class="page-item @(current == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-all-route-data="@RouteFor(Math.Max(1, current - 1))" aria-label="Anterior">
                    <svg class="icon icon-sm" style="transform:scaleX(-1)"><use href="#icon-chevron-right"/></svg>
                    <span class="d-none d-sm-inline ms-1">Anterior</span>
                </a>
            </li>

            @foreach (var p in pages)
            {
                if (p is null)
                {
                    <li class="page-item disabled d-none d-sm-flex" aria-hidden="true">
                        <span class="page-link">…</span>
                    </li>
                }
                else if (p == current)
                {
                    <li class="page-item active" aria-current="page">
                        <span class="page-link">@p</span>
                    </li>
                }
                else
                {
                    <li class="page-item d-none d-sm-flex">
                        <a class="page-link" asp-action="Index" asp-all-route-data="@RouteFor(p.Value)">@p</a>
                    </li>
                }
            }

            <li class="page-item @(current == total ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-all-route-data="@RouteFor(Math.Min(total, current + 1))" aria-label="Próxima">
                    <span class="d-none d-sm-inline me-1">Próxima</span>
                    <svg class="icon icon-sm"><use href="#icon-chevron-right"/></svg>
                </a>
            </li>
        </ul>
        <div class="text-center text-muted small mt-2">
            Página @current de @total
        </div>
    </nav>
}

@section Scripts {
    <script>
        (function () {
            // -------- Foil toggle --------
            document.querySelectorAll('form.foil-editor').forEach(form => {
                const toggle = form.querySelector('.foil-toggle');
                const label = form.querySelector('label.form-check-label');
                if (!toggle) return;

                toggle.addEventListener('change', async () => {
                    const fd = new FormData();
                    for (const inp of form.querySelectorAll('input[type="hidden"]')) {
                        fd.append(inp.name, inp.value);
                    }
                    fd.append('isFoil', toggle.checked ? 'true' : 'false');
                    toggle.disabled = true;
                    try {
                        const res = await fetch(form.action, {
                            method: 'POST',
                            headers: { 'Accept': 'application/json' },
                            body: fd
                        });
                        const data = await res.json().catch(() => ({}));
                        if (!res.ok) {
                            toggle.checked = !toggle.checked;
                            showToast(data.error || 'Erro ao atualizar Foil.', 'error');
                        } else {
                            toggle.checked = data.isFoil;
                            if (label) label.textContent = data.isFoil ? 'Sim' : 'Não';
                            showToast(data.message || 'Atualizado.', 'success');
                        }
                    } catch (err) {
                        toggle.checked = !toggle.checked;
                        showToast('Falha: ' + err.message, 'error');
                    } finally {
                        toggle.disabled = false;
                    }
                });
            });

            // -------- Stock editor --------
            document.querySelectorAll('form.stock-editor').forEach(form => {
                let clickedDelta = null;
                form.querySelectorAll('button[name="delta"]').forEach(btn => {
                    btn.addEventListener('click', () => { clickedDelta = btn.value; });
                });

                form.addEventListener('submit', async ev => {
                    ev.preventDefault();
                    const fd = new FormData(form);
                    if (clickedDelta !== null) fd.set('delta', clickedDelta);
                    else fd.delete('delta');

                    const inputs = form.querySelectorAll('input, button');
                    inputs.forEach(i => i.disabled = true);

                    try {
                        const res = await fetch(form.action, {
                            method: 'POST',
                            headers: { 'Accept': 'application/json' },
                            body: fd
                        });
                        const data = await res.json().catch(() => ({}));
                        if (!res.ok) {
                            showToast(data.error || 'Erro ao atualizar estoque.', 'error');
                        } else {
                            const input = form.querySelector('input[name="newStock"]');
                            if (input) input.value = data.stock;
                            const minusBtn = form.querySelector('button[name="delta"][value="-1"]');
                            if (minusBtn) minusBtn.disabled = data.stock <= 0;
                            showToast(data.message || 'Atualizado.', 'success');
                        }
                    } catch (err) {
                        showToast('Falha: ' + err.message, 'error');
                    } finally {
                        inputs.forEach(i => i.disabled = false);
                        const input = form.querySelector('input[name="newStock"]');
                        const minusBtn = form.querySelector('button[name="delta"][value="-1"]');
                        if (input && minusBtn) minusBtn.disabled = Number(input.value) <= 0;
                        clickedDelta = null;
                    }
                });
            });
        })();
    </script>
}

@inject Microsoft.AspNetCore.Identity.UserManager<RiftboundStore.Models.ApplicationUser> UserManager
@inject RiftboundStore.Services.ICartService CartService
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var uid = UserManager.GetUserId(User);
    var cartCount = string.IsNullOrEmpty(uid) ? 0 : await CartService.GetTotalCountAsync(uid);
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin · @ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="bg-body-tertiary">
    <nav class="navbar navbar-expand-lg bg-dark navbar-dark">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Riftcom · Admin</a>
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link @(currentController == "Cards" ? "active" : "")" asp-area="Admin" asp-controller="Cards" asp-action="Index">Cartas</a></li>
                <li class="nav-item"><a class="nav-link @(currentController == "Scanner" ? "active" : "")" asp-area="Admin" asp-controller="Scanner" asp-action="Index">Scanner</a></li>
                <li class="nav-item"><a class="nav-link @(currentController == "Orders" ? "active" : "")" asp-area="Admin" asp-controller="Orders" asp-action="Index">Pedidos</a></li>
            </ul>
            <div class="d-flex gap-2 align-items-center">
                <a class="btn btn-outline-light btn-sm position-relative" asp-area="" asp-controller="Cart" asp-action="Index" title="Carrinho">
                    🛒 Carrinho
                    @if (cartCount > 0)
                    {
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">@cartCount</span>
                    }
                </a>
                <a class="btn btn-outline-light btn-sm" asp-area="" asp-controller="Home" asp-action="Index">← Ver loja</a>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post" class="m-0">
                    <button type="submit" class="btn btn-outline-light btn-sm">Sair</button>
                </form>
            </div>
        </div>
    </nav>

    <main class="container py-4">
        @if (TempData["AdminMessage"] is string ok)
        {
            <div class="alert alert-success">@ok</div>
        }
        @if (TempData["AdminError"] is string err)
        {
            <div class="alert alert-danger">@err</div>
        }
        @RenderBody()
    </main>

    <div id="toast-stack" class="toast-stack" aria-live="polite" aria-atomic="true"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Global admin helper — call from any admin page for a corner toast.
        window.showToast = function (message, kind) {
            const stack = document.getElementById('toast-stack');
            if (!stack) return;
            const el = document.createElement('div');
            el.className = 'toast-msg toast-' + (kind || 'success');
            el.textContent = message;
            stack.appendChild(el);
            requestAnimationFrame(() => el.classList.add('show'));
            setTimeout(() => {
                el.classList.remove('show');
                el.addEventListener('transitionend', () => el.remove(), { once: true });
            }, 2400);
        };
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
